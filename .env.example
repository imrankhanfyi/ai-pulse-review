# API keys for live pipeline runs.
# Mock mode (npm start) works without any keys.
#
# Gemini API key — for Gemini 2.5 Flash subject model
GEMINI_API_KEY=your-gemini-api-key-here

# OpenRouter API key — for all other subject models and the 3-judge panel
OPENROUTER_API_KEY=your-openrouter-api-key-here
